{
  "permissions": {
    "allow": [
      "Read(~/Developer/**)",
      "Edit(~/Developer/**)",
      "Read(/tmp/**)",
      "Edit(/tmp/**)",
      "Read(~/lore/**)",
      "Edit(~/lore/**)",
{{- if eq .context "kong" }}
      "Edit(~/.local/share/multiwork/**)",
      "Read(~/.local/share/multiwork/**)",
{{- end }}
      "Read(/private/tmp/**)",
      "Edit(/private/tmp/**)",
      "Read(/private/var/folders/**)",
      "Edit(/private/var/folders/**)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
{{- if eq .context "kong" }}
      "Edit(~/.local/share/multiwork/secrets/**)"
{{- end }}
    ],
    "defaultMode": "auto",
    "additionalDirectories": ["~/lore"]
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
{{- if eq .context "kong" }}
  "enabledPlugins": {
    "figma@claude-plugins-official": true
  },
{{- end }}
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "promptCacheTtl": "1h",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "theme": "auto",
  "switchModelsOnFlag": true,
  "agentPushNotifEnabled": true
}
