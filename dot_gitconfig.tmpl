[user]
	name = merrywhether
{{- if eq .context "kong" }}
	email = risto.keravuori@konghq.com
{{- else }}
	email = r@risto.io
{{- end }}
	signingkey = ~/.ssh/id_ed25519.pub
[alias]
	aa = add --all
	cm = commit -m
	co = checkout
	cob = checkout -b
	can = commit --amend --no-edit
	fu = commit --fixup
	lg = log --oneline --graph --decorate
	rh = reset --hard
	# origin where it exists; repos cloned before 2026-11-13 still use o
	rom = rebase origin/main
[commit]
	gpgsign = true
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[diff]
	colormoved = zebra
[fetch]
	prune = true
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[init]
	defaultBranch = main
[merge]
	conflictstyle = zdiff3
	command = meld
[pull]
	rebase = true
[push]
	autoSetupRemote = true
	default = current
[rebase]
	autoSquash = true
	autoStash = true
[rerere]
	enabled = true
[tag]
	gpgsign = true
